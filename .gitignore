# relay (relay/) — source tracked, cross-compiled binaries are not
relay/nd-relay-bin*

# promo kit (promo/) — scripts+data are tracked, render output is not
promo/*.mp4
promo/*.webm
promo/*.wav
promo/*.png
!promo/breez-logo.png

# source art (Aseprite/Photoshop) lives in art/, never under public/ — vite
# copies public/ verbatim into the shipped bundle
*.psd
!art/**/*.psd
!art/**/*.aseprite
